# ===========================================================================
# Clinova Backend Environment Configuration Example
# ===========================================================================
# Copy this template to .env and configure for your target environment.
# NEVER commit .env to version control or share secrets in pull requests.
# Generate secure keys using: python -c "import secrets; print(secrets.token_hex(32))"
# ===========================================================================

# Application Mode
PROJECT_NAME="Clinova API"
API_V1_STR="/api/v1"

# Environment: "development" | "staging" | "production"
# In "production", DEBUG is forced to False and secure JWT_SECRET_KEY is strictly enforced.
ENVIRONMENT="development"
DEBUG=False

# API Documentation: When None/omitted, enabled in dev/staging and disabled in production.
# Set to true if you explicitly want public Swagger UI (/docs) and ReDoc (/redoc) in staging/prod.
ENABLE_API_DOCS=false

# ---------------------------------------------------------------------------
# Database Configuration (PostgreSQL Async)
# ---------------------------------------------------------------------------
# Recommended: Set full async connection string via DATABASE_URL.
# If using standard cloud providers (Supabase, Neon, AWS RDS, GCP Cloud SQL, Render)
# that output "postgres://" or "postgresql://", Clinova automatically adapts them to "postgresql+asyncpg://".
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/clinova"

# Fallback discrete parameters (used only if DATABASE_URL is not set)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_DB="clinova"
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ---------------------------------------------------------------------------
# Security & JWT Authentication
# ---------------------------------------------------------------------------
# REQUIRED in production: Generate a high-entropy secret (at least 32 bytes/64 hex chars).
# Example: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY="replace_with_a_secure_random_key_min_32_characters_long"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins or JSON array.
# In production, set to your exact client domains (no trailing slashes, no wildcard * with credentials):
# BACKEND_CORS_ORIGINS="https://patient.clinova.health,https://hospital.clinova.health"
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# ---------------------------------------------------------------------------
# Medical Document Storage & OCR (Step 7 / Step 12B.3)
# ---------------------------------------------------------------------------
# Storage provider: "local" (default filesystem) | "s3" | "gcs" (Step 12B.3)
STORAGE_PROVIDER="local"
MEDICAL_DOCUMENT_STORAGE_PATH="./storage/medical_documents"
MEDICAL_DOCUMENT_MAX_SIZE_MB=10
DOCUMENT_PROCESSING_ENABLED=true
OCR_PROVIDER="tesseract"
OCR_DEFAULT_LANGUAGE="eng"
OCR_LANGUAGES="eng,hin,mar"

# ===========================================================================
# AI Provider Configuration (Multi-Provider Architecture)
# ===========================================================================
# Provider selection — change these without rewriting application code:
# - Gemini is the normal/default cloud provider.
# - Task-specific providers override the default.
# - Fallback providers are attempted in order.
# - Ollama is intentionally the LAST fallback.
# - Developers may explicitly set AI_DEFAULT_PROVIDER=ollama for local-only development.
# ---------------------------------------------------------------------------

# Primary/default AI provider
AI_DEFAULT_PROVIDER="gemini"

# Feature flags and interview engine tuning
AI_INTERVIEW_ENABLED=true
AI_INTERVIEW_MAX_HISTORY_MESSAGES=20

# Optional task-specific overrides
AI_HISTORY_INTERVIEW_PROVIDER="gemini"
AI_STRUCTURED_EXTRACTION_PROVIDER="gemini"
AI_CLINICAL_SUMMARY_PROVIDER="gemini"
AI_DOCUMENT_ANALYSIS_PROVIDER="gemini"
AI_TRANSLATION_PROVIDER="gemini"
AI_TRIAGE_PROVIDER="gemini"

# Ordered fallback providers (Ollama MUST remain last)
AI_FALLBACK_PROVIDERS="groq,openrouter,ollama"

# ---------------------------------------------------------------------------
# Google Gemini (Default Cloud Provider)
# Obtain key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ---------------------------------------------------------------------------
# OpenAI (and compatible providers via OPENAI_BASE_URL)
# Obtain key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
# OPENAI_API_KEY="your_openai_api_key_here"
OPENAI_MODEL="gpt-4o-mini"
# OPENAI_BASE_URL="https://api.openai.com/v1"

# ---------------------------------------------------------------------------
# Groq (High-speed OpenAI-compatible provider)
# Obtain key: https://console.groq.com/keys
# ---------------------------------------------------------------------------
# GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="llama-3.3-70b-versatile"

# ---------------------------------------------------------------------------
# OpenRouter (Unified multi-model gateway)
# Obtain key: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY="your_openrouter_api_key_here"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# ---------------------------------------------------------------------------
# Ollama (Local self-hosted provider — last fallback)
# Install: https://ollama.ai
# Run model: ollama pull llama3.2 && ollama serve
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
