# Clinova Backend Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
PROJECT_NAME="Clinova API"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL Async)
DATABASE_URL="postgresql+asyncpg://postgres:password@localhost:5432/clinova"
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_DB="clinova"
DB_ECHO=False
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30


# JWT & Security Configuration
JWT_SECRET_KEY="your_super_secret_jwt_key_min_32_characters_long"
JWT_ALGORITHM="HS256"
SECRET_KEY="temporary_dev_secret_key_change_in_production_32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration (Comma-separated URLs for local frontend development)
BACKEND_CORS_ORIGINS="http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174"

# ===========================================================================
# AI Provider Configuration (Multi-Provider Architecture)
# ===========================================================================
# Provider selection — change these without rewriting application code.
#
# - Gemini is the normal/default cloud provider.
# - Task-specific providers override the default.
# - Fallback providers are attempted in order.
# - Ollama is intentionally the LAST fallback.
# - Developers may explicitly set AI_DEFAULT_PROVIDER=ollama for local-only development.
# ---------------------------------------------------------------------------

# Primary/default AI provider
AI_DEFAULT_PROVIDER=gemini

# Optional task-specific overrides
AI_HISTORY_INTERVIEW_PROVIDER=gemini
AI_STRUCTURED_EXTRACTION_PROVIDER=gemini
AI_CLINICAL_SUMMARY_PROVIDER=gemini
AI_DOCUMENT_ANALYSIS_PROVIDER=gemini
AI_TRANSLATION_PROVIDER=gemini
AI_TRIAGE_PROVIDER=gemini

# Ordered fallback providers.
# Ollama MUST remain last.
AI_FALLBACK_PROVIDERS=groq,openrouter,ollama

# ---------------------------------------------------------------------------
# Google Gemini
# Obtain key: https://aistudio.google.com/app/apikey
# ---------------------------------------------------------------------------
# GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# OpenAI (also works for Groq, OpenRouter, Cerebras via OPENAI_BASE_URL)
# Obtain key: https://platform.openai.com/api-keys
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1

# ---------------------------------------------------------------------------
# Groq (OpenAI-compatible — very fast, free tier available)
# Obtain key: https://console.groq.com/keys
# ---------------------------------------------------------------------------
# GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------------
# OpenRouter (access many models via one API)
# Obtain key: https://openrouter.ai/keys
# ---------------------------------------------------------------------------
# OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openai/gpt-4o-mini

# ---------------------------------------------------------------------------
# Ollama (local — no API key, no cost, runs on your machine)
# Install: https://ollama.ai
# Run model: ollama pull llama3.2 && ollama serve
# ---------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
