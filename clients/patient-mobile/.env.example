# ===========================================================================
# Clinova Patient Mobile (React Native / Expo) Environment Configuration Example
# ===========================================================================
# Copy this template to .env when running or creating release builds.
# Variables prefixed with EXPO_PUBLIC_ are bundled into client code.
# NEVER place private backend secrets or credentials in this file.
# ===========================================================================

# Production Cloud Deployment (HTTPS):
EXPO_PUBLIC_API_URL=https://api.clinova.health/api/v1

# Local Testing Scenarios (Uncomment as needed):
#
# 1. Android Emulator on same host:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000/api/v1
#
# 2. Physical device on Local Area Network (Replace with host PC's Wi-Fi IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000/api/v1
#
# 3. iOS Simulator / Web / Localhost:
# EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
