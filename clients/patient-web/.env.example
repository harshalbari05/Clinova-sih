# ===========================================================================
# Clinova Patient Web Environment Configuration Example
# ===========================================================================
# Copy this template to .env or .env.production when building/deploying.
# NOTE: Variables prefixed with VITE_ are embedded into public client bundles.
# NEVER put server secrets or private API keys in client environment files.
# ===========================================================================

# Development (Default):
# VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production Cloud Deployment:
# Point to your secure HTTPS backend domain:
VITE_API_BASE_URL=https://api.clinova.health/api/v1
